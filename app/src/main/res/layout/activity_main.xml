<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100B10">

    <!-- Fondo de Hiyuki -->
    <ImageView
        android:id="@+id/imgHiyuki"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hiyuki_background"
        android:scaleType="centerCrop"
        android:contentDescription="Hiyuki"/>

    <!-- Panel principal de cristal -->
    <LinearLayout
        android:id="@+id/welcomePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="30dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:background="@drawable/panel_crystal"
        android:elevation="12dp">

        <!-- Pantalla inicial -->
        <LinearLayout
            android:id="@+id/initialContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIENVENIDO"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold"
                android:letterSpacing="0.16"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Un mundo de fantasía te espera"
                android:textColor="#E8D5D9"
                android:textSize="14sp"/>

            <!-- Ecualizador -->
            <LinearLayout
                android:id="@+id/soundContainer"
                android:layout_width="100dp"
                android:layout_height="42dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center"/>

            <!-- Botón comenzar -->
            <Button
                android:id="@+id/btnMostrarMensaje"
                android:layout_width="220dp"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:text="COMENZAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.12"
                android:background="@drawable/button_crimson"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="✦  H I Y U K I  ✦"
                android:textColor="#E8AAB7"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Mensaje posterior -->
        <LinearLayout
            android:id="@+id/welcomeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦  HIYUKI  ✦"
                android:textColor="#E8AAB7"
                android:textSize="16sp"
                android:letterSpacing="0.20"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="¡Bienvenido al mundo de Hiyuki!"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Una pequeña experiencia de fantasía te espera."
                android:textColor="#E8D5D9"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- Botón para regresar -->
            <Button
                android:id="@+id/btnVolverInicio"
                android:layout_width="190dp"
                android:layout_height="48dp"
                android:layout_marginTop="26dp"
                android:text="VOLVER AL INICIO"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.06"
                android:background="@drawable/button_crimson"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:elevation="6dp"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>




